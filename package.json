{
  "name": "inccsv",
  "version": "0.1.1",
  "description": "JavaScript implementation of the INC file format.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./fs": "./src/fs.js"
  },
  "files": [
    "src/",
    "dist/",
    "docs/",
    "examples/",
    "scripts/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "RELEASE.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "node scripts/build-browser.js",
    "docs": "node scripts/docs-server.js",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test",
    "release:check": "npm run build && npm test && npm pack --dry-run",
    "test": "node --test"
  },
  "keywords": [
    "inc",
    "csv",
    "metadata",
    "ini",
    "tabular-data",
    "self-describing-data"
  ],
  "author": "Matthew Roughan",
  "license": "MIT",
  "homepage": "https://github.com/mroughan/IncCSV.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mroughan/IncCSV.js.git"
  },
  "bugs": {
    "url": "https://github.com/mroughan/IncCSV.js/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
